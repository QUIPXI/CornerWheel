# Public release configuration template. Run from the project root.
# Copy to the ignored Scripts/release.local.env, then fill in your own settings.
# Never put passwords, private keys, or notarization credentials in this file.
# See Docs/ReleasePreparation.md before running any release command.
export CORNERWHEEL_RELEASE_VERSION="${CORNERWHEEL_RELEASE_VERSION:-}"
export CORNERWHEEL_RELEASE_BUILD="${CORNERWHEEL_RELEASE_BUILD:-}"
# After moving to a source repository without old release tags/history, explicitly
# set CORNERWHEEL_PREVIOUS_BUILD in the ignored local configuration to the highest
# build verified in the published feed/release records. It must be an integer;
# do not leave it empty or rely on the tool's fallback floor of 1. Choose a higher
# CORNERWHEEL_RELEASE_BUILD. Preserve only verified public ZIP/feed/notes in staging.
export CORNERWHEEL_DEVELOPMENT_TEAM="${CORNERWHEEL_DEVELOPMENT_TEAM:-}"
export CORNERWHEEL_SIGNING_IDENTITY="${CORNERWHEEL_SIGNING_IDENTITY:-}"
export CORNERWHEEL_NOTARY_PROFILE="${CORNERWHEEL_NOTARY_PROFILE:-}"
export CORNERWHEEL_SPARKLE_ACCOUNT="${CORNERWHEEL_SPARKLE_ACCOUNT:-CornerWheel}"
export CORNERWHEEL_SPARKLE_BIN="${CORNERWHEEL_SPARKLE_BIN:-$PWD/Build/ReleaseDependencies/SourcePackages/artifacts/sparkle/Sparkle/bin}"
export CORNERWHEEL_UPDATE_PUBLIC_KEY="${CORNERWHEEL_UPDATE_PUBLIC_KEY:-GI7LEWXfjcHWclVAPX2oDYJ5QUefPml+ozHhmpjPdO0=}"
export CORNERWHEEL_UPDATE_FEED_URL="${CORNERWHEEL_UPDATE_FEED_URL:-https://updates.cornerwheel.com/appcast.xml}"
export CORNERWHEEL_DOWNLOAD_URL_PREFIX="${CORNERWHEEL_DOWNLOAD_URL_PREFIX:-https://updates.cornerwheel.com/}"
export CORNERWHEEL_RELEASE_NOTES="${CORNERWHEEL_RELEASE_NOTES:-}"
# Required only for the explicitly invoked private backup/staging commands.
export CORNERWHEEL_BACKUP_REPOSITORY="${CORNERWHEEL_BACKUP_REPOSITORY:-}"
